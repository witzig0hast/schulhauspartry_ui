# Pflicht in Produktion
ADMIN_PASSWORD=bitte-ein-langes-zufaelliges-passwort
APP_SECRET=mindestens-32-zeichen-zufallswert-hier-einsetzen-1234567890
# oeffentliche URL (fuer den Spotify-OAuth-Redirect), ohne Slash am Ende
PUBLIC_URL=https://party.example.de
# hinter Cloudflare: echte Client-IP aus CF-Connecting-IP lesen
TRUST_CLOUDFLARE=true
# optional: Spotify-App-Zugangsdaten (alternativ im Admin-Bereich eintragen)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Docker-Netz des Nginx Proxy Managers (nur fuer docker-compose.npm.yml)
NPM_NETWORK=proxy
# WireGuard (nur docker-compose.vpn.yml): oeffentlicher Name des Heimservers fuer den Pi, z. B. wg.example.de
WG_SERVERURL=wg.example.de

# VPN (nur mit docker-compose.vpn.yml): Domain des WireGuard-Servers (DNS ohne Cloudflare-Proxy) und Token fuer die VPN-Verwaltung im Admin
WG_SERVERURL=wg.example.de
WGCTL_TOKEN=bitte-mit-openssl-rand-hex-24-erzeugen
