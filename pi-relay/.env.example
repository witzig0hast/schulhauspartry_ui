# IP des X32 im Netzwerk (am X32: Setup -> Network, feste IP vergeben!)
X32_HOST=192.168.1.50
# Geheimer Token (muss identisch in der App unter Admin -> Verbindungen -> Token stehen)
RELAY_TOKEN=bitte-mindestens-16-zeichen-zufallswert
# nur im VPN-Tunnel lauschen (Tunnel-IP des Pi)
BIND=10.8.0.2
PORT=8080
# Eingangskanaele am X32 (ch/01..32), wie im Admin eingetragen
P1_CHANNELS=1,2
P2_CHANNELS=3,4
MIC_CHANNELS=5,6,7
